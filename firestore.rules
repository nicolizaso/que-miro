rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona es dueña exclusiva de su rama del árbol: nadie lee ni
    // escribe fuera de `users/{su propio uid}`.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, write: if isOwner();

      match /saved_media/{tmdbId} {
        allow read, write: if isOwner();
      }

      match /collections/{collectionId} {
        allow read, write: if isOwner();
      }
    }
  }
}
