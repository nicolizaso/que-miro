rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona es dueña exclusiva de su rama del árbol: nadie lee ni
    // escribe fuera de `users/{su propio uid}`.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, write: if isOwner();

      match /saved_media/{tmdbId} {
        allow read, write: if isOwner();
      }

      match /collections/{collectionId} {
        allow read, write: if isOwner();
      }
    }

    /**
     * Perfiles públicos.
     *
     * Es la única colección que se lee sin sesión, y a propósito no cuelga de
     * `users/`: lo que hay acá es una instantánea que la persona eligió
     * publicar, no una ventana a su biblioteca. Abrir `saved_media` a lectura
     * anónima expondría también todo lo que no quiso mostrar.
     *
     * Escribir exige ser dueño del `uid` que declara el documento, y en una
     * edición ese `uid` no puede cambiar: sin esa condición, cualquiera con
     * sesión podría apropiarse del slug de otro reescribiéndolo.
     */
    match /public_profiles/{slug} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }
  }
}
