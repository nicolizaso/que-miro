rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona es dueña exclusiva de su rama del árbol: nadie lee ni
    // escribe fuera de `users/{su propio uid}`.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, write: if isOwner();

      match /saved_media/{tmdbId} {
        allow read, write: if isOwner();
      }

      match /collections/{collectionId} {
        allow read, write: if isOwner();
      }

      // "Contanos de vos" (`profile/taste`), las metas del año
      // (`profile/goals`) y las plataformas que se pagan
      // (`profile/subscriptions`): documentos de la cuenta. Mismo dueño y mismas
      // reglas que la biblioteca — son datos de la persona, no algo publicado.
      // Un documento nuevo acá no necesita regla nueva: `{docId}` ya lo cubre.
      match /profile/{docId} {
        allow read, write: if isOwner();
      }
    }

    /**
     * Perfiles públicos.
     *
     * Es la única colección que se lee sin sesión, y a propósito no cuelga de
     * `users/`: lo que hay acá es una instantánea que la persona eligió
     * publicar, no una ventana a su biblioteca. Abrir `saved_media` a lectura
     * anónima expondría también todo lo que no quiso mostrar.
     *
     * Escribir exige ser dueño del `uid` que declara el documento, y en una
     * edición ese `uid` no puede cambiar: sin esa condición, cualquiera con
     * sesión podría apropiarse del slug de otro reescribiéndolo.
     */
    match /public_profiles/{slug} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    /**
     * Avisos de episodios: la instantánea que lee el cron diario
     * (`api/cron/notify.ts`, con Firebase Admin, que no pasa por estas reglas).
     *
     * Fuera de `users/` por lo mismo que los perfiles públicos: el servidor no
     * lee la biblioteca de nadie, solo esto. Pero no es pública: los tokens
     * son de los dispositivos de la persona y la lista de series es suya, así
     * que la lee y la escribe solo su dueño.
     *
     * Las claves están cerradas a propósito. Lo que se publica para el
     * servidor es tokens, país, idioma y los ids de las series con aviso; si
     * algún día se colara un estado o un puntaje, la escritura tiene que
     * fallar acá y no terminar en un documento que lee el servidor.
     */
    match /push_subscriptions/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read, delete: if isOwner();

      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['tokens', 'series', 'region', 'language', 'updatedAt'])
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 10
        && request.resource.data.series is list
        && request.resource.data.series.size() <= 1000;
    }
  }
}
