{
  "rules": [
    {
      "collection": "users",
      "path": "/users/{userId}",
      "description": "User profiles",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      }
    },
    {
      "collection": "saved_media",
      "path": "/users/{userId}/saved_media/{tmdbId}",
      "description": "Saved movies and TV shows for a user",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "tmdbId", "type": "number", "required": true },
          { "name": "mediaType", "type": "string", "required": true },
          { "name": "title", "type": "string", "required": true },
          { "name": "posterPath", "type": "string", "required": false },
          { "name": "backdropPath", "type": "string", "required": false },
          { "name": "releaseYear", "type": "string", "required": false },
          { "name": "genres", "type": "list", "required": false },
          { "name": "status", "type": "string", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true },
          { "name": "runtime", "type": "number", "required": false },
          { "name": "seasons", "type": "list", "required": false },
          { "name": "totalEpisodes", "type": "number", "required": false },
          { "name": "providers", "type": "list", "required": false },
          { "name": "streaming", "type": "list", "required": false },
          { "name": "providerRegion", "type": "string", "required": false },
          { "name": "people", "type": "list", "required": false },
          { "name": "keywords", "type": "list", "required": false },
          { "name": "sagaId", "type": "number", "required": false },
          { "name": "sagaName", "type": "string", "required": false },
          { "name": "originalLanguage", "type": "string", "required": false },
          { "name": "releaseDate", "type": "string", "required": false },
          { "name": "digitalRelease", "type": "string", "required": false },
          { "name": "enrichedLanguage", "type": "string", "required": false },
          { "name": "enrichedRegion", "type": "string", "required": false },
          { "name": "enrichedAt", "type": "timestamp", "required": false },
          { "name": "seriesStatus", "type": "string", "required": false },
          { "name": "lastAired", "type": "map", "required": false },
          { "name": "nextToAir", "type": "map", "required": false },
          { "name": "newEpisodesSince", "type": "map", "required": false },
          { "name": "archive", "type": "map", "required": false },
          { "name": "availabilityNews", "type": "list", "required": false },
          { "name": "notify", "type": "boolean", "required": false },
          { "name": "progress", "type": "map", "required": false },
          { "name": "history", "type": "list", "required": false },
          { "name": "collections", "type": "list", "required": false },
          { "name": "duelScore", "type": "number", "required": false },
          { "name": "duelCount", "type": "number", "required": false },
          { "name": "addedAt", "type": "timestamp", "required": false },
          { "name": "addedFrom", "type": "map", "required": false },
          { "name": "hiddenFromFollowers", "type": "boolean", "required": false },
          { "name": "review", "type": "map", "required": false }
        ]
      }
    },
    {
      "collection": "collections",
      "path": "/users/{userId}/collections/{collectionId}",
      "description": "User-defined lists beyond the three statuses; membership lives in saved_media.collections. publicId points to its public_lists snapshot while published",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "id", "type": "string", "required": true },
          { "name": "name", "type": "string", "required": true },
          { "name": "createdAt", "type": "timestamp", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true },
          { "name": "publicId", "type": "string", "required": false },
          { "name": "publishedAt", "type": "timestamp", "required": false }
        ]
      }
    },
    {
      "collection": "profile",
      "path": "/users/{userId}/profile/taste",
      "description": "Declared taste from the 'Contanos de vos' questionnaire",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "movie", "type": "map", "required": false },
          { "name": "series", "type": "map", "required": false },
          { "name": "genres", "type": "list", "required": true },
          { "name": "actors", "type": "list", "required": true },
          { "name": "directors", "type": "list", "required": true },
          { "name": "studios", "type": "list", "required": true },
          { "name": "decade", "type": "number", "required": false },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "profile",
      "path": "/users/{userId}/profile/goals",
      "description": "Annual goals (movies, series, hours) per year, synced newest-wins like the taste document",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "byYear", "type": "map", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "profile",
      "path": "/users/{userId}/profile/subscriptions",
      "description": "Streaming platforms the user pays for, used by the 'available now' filter and Explore's platform rows. onlyMine (optional, only written when on) limits Explore to what is included in them. Synced newest-wins",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "providers", "type": "list", "required": true },
          { "name": "onlyMine", "type": "boolean", "required": false },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "profile",
      "path": "/users/{userId}/profile/restrictions",
      "description": "What the user doesn't want recommended in Explore (minimum release year for movies, series or both, and excluded genres). Its own document and not a field of profile/taste because the questionnaire is written whole and an older client would erase it; synced newest-wins, in the backup and deleted with the account",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "minYear", "type": "map", "required": false },
          { "name": "excludedGenres", "type": "list", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "profile",
      "path": "/users/{userId}/profile/calendar",
      "description": "Which token the account's subscribable calendar uses; null when turned off. Not in the backup: it is a capability link, not data",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "token", "type": "string", "required": false },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "profile",
      "path": "/users/{userId}/profile/following",
      "description": "Legacy follows of public profiles by slug (before accounts existed). Migrated to follows/ once the followed person creates their account; entries left here keep feeding their public reviews. Synced newest-wins, in the backup and deleted with the account",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "profiles", "type": "list", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "profile",
      "path": "/users/{userId}/profile/social",
      "description": "Social settings that are never published: what followers can see (sharing), paused activity, muted uids and when notifications were last read. Synced newest-wins, in the backup and deleted with the account",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      },
      "schema": {
        "fields": [
          { "name": "sharing", "type": "map", "required": true },
          { "name": "paused", "type": "boolean", "required": true },
          { "name": "muted", "type": "list", "required": true },
          { "name": "inboxSeenAt", "type": "timestamp", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "blocks",
      "path": "/users/{userId}/blocks/{otherUid}",
      "description": "Who the user blocked. Owner-only; other rules check it with exists() so a blocked person cannot follow, read the activity or send recommendations",
      "access": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId && otherUid != userId"
      },
      "schema": {
        "fields": [
          { "name": "at", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "recommendations",
      "path": "/users/{userId}/recommendations/{fromUid}_{mediaType}{tmdbId}",
      "description": "'Te lo recomiendo' from a mutual follower: the only thing under users/ written by someone else. Closed keys, id signed with the sender uid; read and deleted by the recipient (and by the sender, for account deletion)",
      "access": {
        "read": "isOwner() || resource.data.from == request.auth.uid",
        "create": "request.auth.uid != userId && validRecommendation() && isMutual(request.auth.uid, userId) && !blocked(userId, request.auth.uid)",
        "delete": "isOwner() || resource.data.from == request.auth.uid"
      },
      "schema": {
        "fields": [
          { "name": "from", "type": "string", "required": true },
          { "name": "fromName", "type": "string", "required": true },
          { "name": "fromHandle", "type": "string", "required": true },
          { "name": "tmdbId", "type": "number", "required": true },
          { "name": "mediaType", "type": "string", "required": true },
          { "name": "title", "type": "string", "required": true },
          { "name": "posterPath", "type": "string", "required": false },
          { "name": "releaseYear", "type": "string", "required": false },
          { "name": "note", "type": "string", "required": true },
          { "name": "at", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "public_profiles",
      "path": "/public_profiles/{slug}",
      "description": "Curated public snapshot of a library (never a window into saved_media). Public read; writes only by the uid the document declares, which cannot change. Republished automatically while autoUpdate is on. Optionally, the Por Ver list (includeWatchlist) and the names of the platforms paid for (includeSubscriptions), both off by default, for \"¿Qué miramos juntos?\". The slug is the account handle once the person has one. A private account cannot write it (the rule checks accounts/{uid}.private), so an old PWA cannot republish it",
      "access": {
        "read": "true",
        "create": "request.auth != null && request.auth.uid == request.resource.data.uid && !isPrivate(request.auth.uid)",
        "update": "request.auth != null && request.auth.uid == resource.data.uid && request.resource.data.uid == resource.data.uid && !isPrivate(request.auth.uid)",
        "delete": "request.auth != null && request.auth.uid == resource.data.uid"
      },
      "schema": {
        "fields": [
          { "name": "slug", "type": "string", "required": true },
          { "name": "uid", "type": "string", "required": true },
          { "name": "displayName", "type": "string", "required": true },
          { "name": "publishedAt", "type": "timestamp", "required": true },
          { "name": "autoUpdate", "type": "boolean", "required": false },
          { "name": "includeWatchlist", "type": "boolean", "required": false },
          { "name": "includeSubscriptions", "type": "boolean", "required": false },
          { "name": "watchlist", "type": "list", "required": false },
          { "name": "subscriptions", "type": "list", "required": false },
          { "name": "summary", "type": "map", "required": true },
          { "name": "topGenres", "type": "list", "required": true },
          { "name": "favorites", "type": "list", "required": true },
          { "name": "reviews", "type": "list", "required": true }
        ]
      }
    },
    {
      "collection": "public_lists",
      "path": "/public_lists/{listId}",
      "description": "Curated snapshot of a shared list: name, optional description and minimal items (tmdbId, mediaType, title, posterPath, releaseYear). Public get, list forbidden, owner-only writes with immutable uid; republished automatically while autoUpdate is on",
      "access": {
        "get": "true",
        "list": "false",
        "create": "request.auth != null && request.auth.uid == request.resource.data.uid && listId.matches('^[A-Za-z0-9_-]{12,32}$')",
        "update": "request.auth != null && request.auth.uid == resource.data.uid && request.resource.data.uid == resource.data.uid",
        "delete": "request.auth != null && request.auth.uid == resource.data.uid"
      },
      "schema": {
        "fields": [
          { "name": "id", "type": "string", "required": true },
          { "name": "uid", "type": "string", "required": true },
          { "name": "ownerName", "type": "string", "required": true },
          { "name": "name", "type": "string", "required": true },
          { "name": "description", "type": "string", "required": false },
          { "name": "items", "type": "list", "required": true },
          { "name": "publishedAt", "type": "timestamp", "required": true },
          { "name": "autoUpdate", "type": "boolean", "required": false }
        ]
      }
    },
    {
      "collection": "calendar_feeds",
      "path": "/calendar_feeds/{token}",
      "description": "Snapshot behind /cal/{token}.ics: only upcoming episodes (series, season, episode, name, date). Public get by long random token, list forbidden, owner-only writes with immutable uid",
      "access": {
        "get": "true",
        "list": "false",
        "create": "request.auth != null && request.auth.uid == request.resource.data.uid && token.matches('^[A-Za-z0-9_-]{32,64}$')",
        "update": "request.auth != null && request.auth.uid == resource.data.uid && request.resource.data.uid == resource.data.uid",
        "delete": "request.auth != null && request.auth.uid == resource.data.uid"
      },
      "schema": {
        "fields": [
          { "name": "uid", "type": "string", "required": true },
          { "name": "events", "type": "list", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "push_subscriptions",
      "path": "/push_subscriptions/{uid}",
      "description": "Snapshot read by the daily episode-alerts cron: device tokens, region, language and only the ids of series with alerts on. Outside users/ so the server never reads the library; owner-only, closed keys",
      "access": {
        "read": "request.auth != null && request.auth.uid == uid",
        "write": "request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['tokens', 'series', 'region', 'language', 'updatedAt'])"
      },
      "schema": {
        "fields": [
          { "name": "tokens", "type": "list", "required": true },
          { "name": "series", "type": "list", "required": true },
          { "name": "region", "type": "string", "required": true },
          { "name": "language", "type": "string", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "handles",
      "path": "/handles/{handle}",
      "description": "Unique usernames: the document id is the handle. Public get by exact handle, list forbidden (not a directory). Cannot take the public_profiles slug of another account. Never updated: renaming creates the new one and deletes the old one in the same batch as the account",
      "access": {
        "get": "true",
        "list": "false",
        "create": "request.auth.uid == request.resource.data.uid && handle matches ^[a-z0-9]+(-[a-z0-9]+)*$ (3-24) && the public_profiles slug is not someone else's",
        "update": "false",
        "delete": "resource.data.uid == request.auth.uid"
      },
      "schema": {
        "fields": [
          { "name": "uid", "type": "string", "required": true },
          { "name": "createdAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "accounts",
      "path": "/accounts/{uid}",
      "description": "Public card of an account: handle, name, bio, avatar (a TMDB image path), top 4, private flag and follower counts (written by the owner, counted from follows). Public get even for private accounts ('Cuenta privada'), list forbidden. Nothing from the library",
      "access": {
        "get": "true",
        "list": "false",
        "write": "request.auth.uid == uid && closed keys && getAfter(handles/{handle}).uid == uid"
      },
      "schema": {
        "fields": [
          { "name": "uid", "type": "string", "required": true },
          { "name": "handle", "type": "string", "required": true },
          { "name": "displayName", "type": "string", "required": true },
          { "name": "bio", "type": "string", "required": true },
          { "name": "avatarPath", "type": "string", "required": false },
          { "name": "top4", "type": "list", "required": true },
          { "name": "private", "type": "boolean", "required": true },
          { "name": "followers", "type": "number", "required": true },
          { "name": "following", "type": "number", "required": true },
          { "name": "createdAt", "type": "timestamp", "required": true },
          { "name": "updatedAt", "type": "timestamp", "required": true }
        ]
      }
    },
    {
      "collection": "follows",
      "path": "/follows/{followerUid}_{followedUid}",
      "description": "Who follows whom. Created only by the follower; the rule decides the status (pending for a private account, accepted for a public one). Only the followed person accepts; either party deletes. Readable only by the two parties",
      "access": {
        "get": "request.auth.uid in followId.split('_')",
        "list": "request.auth.uid in [resource.data.follower, resource.data.followed]",
        "create": "follower == request.auth.uid && both have accounts && not blocked && status == (isPrivate(followed) ? 'pending' : 'accepted')",
        "update": "followed == request.auth.uid && pending -> accepted, only status and acceptedAt",
        "delete": "either party"
      },
      "schema": {
        "fields": [
          { "name": "follower", "type": "string", "required": true },
          { "name": "followed", "type": "string", "required": true },
          { "name": "status", "type": "string", "required": true },
          { "name": "createdAt", "type": "timestamp", "required": true },
          { "name": "acceptedAt", "type": "timestamp", "required": false }
        ]
      }
    },
    {
      "collection": "activity",
      "path": "/activity/{uid}",
      "description": "Curated social snapshot republished by the owner's app (never a window into saved_media): last events, 'viendo ahora', a compact library index and Por Ver (if shared), published lists and reaction counts. Readable with a session by anyone if the account is public, or by accepted followers if private; never by someone the owner blocked",
      "access": {
        "get": "canReadActivity(uid)",
        "list": "false",
        "write": "request.auth.uid == uid && closed keys and size caps"
      },
      "schema": {
        "fields": [
          { "name": "uid", "type": "string", "required": true },
          { "name": "handle", "type": "string", "required": true },
          { "name": "displayName", "type": "string", "required": true },
          { "name": "avatarPath", "type": "string", "required": false },
          { "name": "updatedAt", "type": "timestamp", "required": true },
          { "name": "events", "type": "list", "required": true },
          { "name": "watching", "type": "list", "required": true },
          { "name": "library", "type": "list", "required": true },
          { "name": "watchlist", "type": "list", "required": true },
          { "name": "lists", "type": "list", "required": true },
          { "name": "reactions", "type": "map", "required": true }
        ]
      }
    },
    {
      "collection": "reactions",
      "path": "/activity/{uid}/reactions/{reactorUid}_{eventId}",
      "description": "One reaction per person and event (fire, love, laugh, cry, wow). Written by whoever can read that activity, signed with their uid. Read by the owner (who folds counts into the snapshot) and by the reactor",
      "access": {
        "read": "request.auth.uid == uid || resource.data.reactor == request.auth.uid",
        "write": "canReadActivity(uid) && reactor == request.auth.uid && closed keys",
        "delete": "owner or reactor"
      },
      "schema": {
        "fields": [
          { "name": "reactor", "type": "string", "required": true },
          { "name": "reactorName", "type": "string", "required": true },
          { "name": "reactorHandle", "type": "string", "required": true },
          { "name": "eventId", "type": "string", "required": true },
          { "name": "emoji", "type": "string", "required": true },
          { "name": "at", "type": "timestamp", "required": true }
        ]
      }
    }
  ]
}
