# ---------------------------------------------------------------------------
# TMDB — se usa SOLO en el servidor (funciones en api/ y el server de dev).
# No lleva prefijo VITE_ a propósito: así nunca termina en el bundle público.
# Conseguí la tuya en https://www.themoviedb.org/settings/api
# ---------------------------------------------------------------------------
TMDB_API_KEY=""

# ---------------------------------------------------------------------------
# Firebase (Auth + Firestore) — opcional.
# Si no la completás, la app arranca igual en "modo invitado" (solo localStorage).
# Estos valores son públicos por diseño en apps web de Firebase: la seguridad
# real la dan las reglas de Firestore (ver firestore.rules) y los dominios
# autorizados en la consola de Firebase.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Solo si tu proyecto NO usa la base "(default)" de Firestore (por ejemplo, una
# base con nombre creada desde gcloud o una segunda base en otra región). Si la
# consola tira "Database '(default)' not found", o creás la base por defecto o
# ponés acá el nombre de la que tengas.
VITE_FIREBASE_DATABASE_ID=""
